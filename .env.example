# Copy this file to .env and fill in real values for your environment.
# .env is gitignored; never commit real secrets.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://oliveoil:oliveoil_dev_pw@localhost:5433/oliveoil

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:8000/stripe/webhook/`
STRIPE_WEBHOOK_SECRET=whsec_...

# Console backend prints emails to stdout in dev; switch to SMTP in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Aceite de Oliva <no-reply@example.com>
CONTACT_EMAIL=hola@example.com

# Google Sign-In — leave blank to hide the "Continuar con Google" button.
# Create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials and authorize the
# redirect URI <your domain>/login/google/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
